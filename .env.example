# Copy this file to .env (repo root) and fill in real values. Shared by backend/ and frontend/.

# Backend (Express)
BACKEND_PORT=5000
# development = admin endpoints open (no auth yet) | production = admin endpoints disabled. Defaults to production.
APP_ENV=development
# Log verbosity: null (no logs) | error | warn | info | http (+ request/response) | debug (everything)
LOG_LEVEL=debug
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# IANA time zone of the salon, used to reject bookings in the past
SALON_TIMEZONE=Asia/Kolkata
# Max POST /api/appointments requests per client IP per window
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MINUTES=15
# Number of reverse proxies in front of the app (auto-set to 1 on Render)
# TRUST_PROXY=1

# Supabase (backend only - never expose the service role key to the frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (Next.js)
FRONTEND_PORT=3000
# Leave empty for the bundled deploy (same origin); use http://localhost:5000 with `next dev`
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Used to verify the .env file is reachable from every part of the code
CUSTOM_MESSAGE=Hello from the shared SunSaloon .env file!
