# Copy this file to .env (repo root) and fill in real values. Shared by backend/ and frontend/.

# Backend (Express)
BACKEND_PORT=5000
# development | production. Defaults to production. (Admin access no longer depends on this - see ADMIN_API_KEY.)
APP_ENV=production
# Secret for admin endpoints, sent as "Authorization: Bearer <key>". At least 24 characters; leave empty to keep admin endpoints disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
# Log verbosity: null (no logs) | error | warn | info | http (+ request/response) | debug (everything)
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# IANA time zone of the salon, used to reject bookings in the past
SALON_TIMEZONE=Asia/Kolkata
# Max POST /api/appointments requests per client IP per window
BOOKING_RATE_LIMIT_MAX=10
BOOKING_RATE_LIMIT_WINDOW_MINUTES=15
# Pending + confirmed upcoming appointments one phone number may hold at once
MAX_ACTIVE_BOOKINGS_PER_PHONE=3
# Bookable slots, all in SALON_TIMEZONE: opening/closing time (HH:MM), slot length, how far ahead customers may book
SALON_OPENING_TIME=09:00
SALON_CLOSING_TIME=21:00
BOOKING_SLOT_MINUTES=30
BOOKING_MAX_ADVANCE_DAYS=90
# Number of reverse proxies in front of the app (auto-set to 1 on Render). On any other host behind a proxy or load
# balancer you MUST set this (e.g. 1), otherwise every visitor shares one rate-limit bucket (the proxy's IP).
# Do not set it when the app is exposed directly to the internet - clients could then fake their IP.
# TRUST_PROXY=1

# Supabase (backend only - never expose the service role key to the frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (Next.js)
FRONTEND_PORT=3000
# Leave EMPTY for the bundled deploy (Express serves the site and the API on one origin). This value is baked into the
# browser JavaScript at build time, so a localhost URL here would make every visitor's browser call their own machine.
# Only for a separate `next dev` server, set it to http://localhost:5000 in your local .env (never in production).
NEXT_PUBLIC_API_BASE_URL=
# Server-side backend URL used by Next.js (optional; defaults to http://localhost:BACKEND_PORT)
# API_BASE_URL=http://localhost:5000

# Used to verify the .env file is reachable from every part of the code
CUSTOM_MESSAGE=Hello from the shared SunSaloon .env file!
