# Copy this file to .env (repo root) and fill in real values. Shared by backend/ and frontend/.

# Backend (Express)
BACKEND_PORT=5000
# Log verbosity: null (no logs) | error | warn | info | http (+ request/response) | debug (everything)
LOG_LEVEL=debug
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (backend only - never expose the service role key to the frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (Next.js)
FRONTEND_PORT=3000
# Leave empty for the bundled deploy (same origin); use http://localhost:5000 with `next dev`
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Used to verify the .env file is reachable from every part of the code
CUSTOM_MESSAGE=Hello from the shared SunSaloon .env file!
